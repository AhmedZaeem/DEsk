+// DEsk/Red Ronin: the release point, signalled when the compositor lets go
+// of the buffer committed with it -- the moment wl_buffer.release would be
+// sent. Upstream 0.18 never signals it, and a client waiting on it stalls.
+struct syncobj_release {
+	struct wlr_drm_syncobj_timeline *timeline;
+	uint64_t point;
+	struct wl_listener buffer_release;
+	struct wl_listener buffer_destroy;
+};
+
+// The compositor's GPU may still be reading the buffer when its last lock
+// goes (a pass is only flushed): it gives a fence for the GL work submitted
+// so far, as a sync_file, and the release point is that fence; without one
+// (-1) the point is signalled at once.
+static int (*release_fence_fn)(void *data);
+static void *release_fence_data;
+
+void wlr_linux_drm_syncobj_v1_desk_set_release_fence(int (*fn)(void *data), void *data);
+void wlr_linux_drm_syncobj_v1_desk_set_release_fence(int (*fn)(void *data), void *data) {
+	release_fence_fn = fn;
+	release_fence_data = data;
+}
+
+static void syncobj_release_fire(struct syncobj_release *rel) {
+	int fence = release_fence_fn ? release_fence_fn(release_fence_data) : -1;
+	bool done = fence >= 0 &&
+		wlr_drm_syncobj_timeline_import_sync_file(rel->timeline, rel->point, fence);
+	if (fence >= 0) {
+		close(fence);
+	}
+	if (!done && drmSyncobjTimelineSignal(rel->timeline->drm_fd, &rel->timeline->handle,
+			&rel->point, 1) != 0) {
+		wlr_log_errno(WLR_ERROR, "drmSyncobjTimelineSignal() failed");
+	}
+	wl_list_remove(&rel->buffer_release.link);
+	wl_list_remove(&rel->buffer_destroy.link);
+	wlr_drm_syncobj_timeline_unref(rel->timeline);
+	free(rel);
+}
+
+static void syncobj_release_handle_release(struct wl_listener *listener, void *data) {
+	struct syncobj_release *rel = wl_container_of(listener, rel, buffer_release);
+	syncobj_release_fire(rel);
+}
+
+static void syncobj_release_handle_destroy(struct wl_listener *listener, void *data) {
+	struct syncobj_release *rel = wl_container_of(listener, rel, buffer_destroy);
+	syncobj_release_fire(rel);
+}
+
+static bool syncobj_release_watch(struct wlr_buffer *buffer,
+		struct wlr_drm_syncobj_timeline *timeline, uint64_t point) {
+	struct syncobj_release *rel = calloc(1, sizeof(*rel));
+	if (rel == NULL) {
+		return false;
+	}
+	rel->timeline = wlr_drm_syncobj_timeline_ref(timeline);
+	rel->point = point;
+	rel->buffer_release.notify = syncobj_release_handle_release;
+	wl_signal_add(&buffer->events.release, &rel->buffer_release);
+	rel->buffer_destroy.notify = syncobj_release_handle_destroy;
+	wl_signal_add(&buffer->events.destroy, &rel->buffer_destroy);
+	return true;
+}
+
+// DEsk/Red Ronin: tells the compositor this wlroots waits for signalled
+// acquire points and signals release points (it offers the protocol only then)
+bool wlr_linux_drm_syncobj_v1_desk_releases(void);
+bool wlr_linux_drm_syncobj_v1_desk_releases(void) {
+	return true;
+}
